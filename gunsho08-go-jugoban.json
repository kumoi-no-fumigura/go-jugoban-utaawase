 "poems": [
  {
   "seq": "1",
   "text": "五月やみくらはし山の郭公おほつかなくも鳴わたるかな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "限あればけふぬきすてつふち衣はてなき物は涙也けり",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "こよひきみいかなる里の月をみて都に誰を思ひいつらん",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "くらきよりくらき道にそ入ぬへきはるかに照せ山のはの月",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "世中にあらましかはと思ふ人のなきはおほくも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "夢ならて又もみるへき君ならはねられぬいをも歎かさらまし",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "もろともに出すはこしと契りしをいかゝなりにし山のはの月",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "君まつと山のは出て山の端の入まて月をなかめつるかな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "こゝのへのうちまて照す月影にあれたる宿を思ひ社やれ",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "行末のしるしはかりに殘るへき松さへいたく老にけるかな",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "引わかれ袂にかゝる菖蒲草おなしよと野におひにしものを",
   "kana": "",
   "speaker": "",
   "page": 498,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "我宿の松はしるしもなかりけり杉むらならは尋ねきなまし",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "夏の夜をまたせ〓〓て郭公たゝ一聲もなき渡るかな",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "よしさらはつらさは我に習ひけり賴めてこぬは誰かをしへし",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "いにしへのならの都の八櫻けふこゝの重に匂ひぬるかな",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "かきつめしねたさもねたしもしほ草思はぬかたに烟たなひく",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "春のうちにちり積る共きよめせし花にけかるゝ宿といはせん",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "詠むるに物思ふ〓とのなくさむは月は浮世の外よりや行",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "さはへなす荒振神もをしなへてけふはなこしのはらへなり鳬",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "忍ふれはくるしかりけりしの薄あきのさかりに成やしなまし",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "八重むくらしけれる宿の淋しきに人社しられ秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "君すまはとはまし物を津國のいく田の杜の秋の初風",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "水のうへに秋の山邊をうつしてははたはりひろに錦とそみる",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "春來てそ人もとひける山里は花こそ宿のあるし也けれ",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "あふ坂の關の岩かとふみならし山たちいつるきり原の駒",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "木のもとを住家とすれはをのつから花みる人になりぬへき哉",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "世にふれは物思ふとしもなけれとも月に幾たび詠めしつらん",
   "kana": "",
   "speaker": "",
   "page": 499,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
